# Dockerfile.fastapi

# Step 1: Start with Python 3.10
FROM python:3.10-slim

# Step 2: Set working folder inside container
WORKDIR /app

# Step 3: Copy requirements file first
COPY requirements-docker.txt .

# Step 4: Install all libraries
RUN pip install --no-cache-dir -r requirements-docker.txt

# Step 5: Copy your FastAPI code
COPY fastapi_app.py .
COPY src/ ./src/

# Step 6: Bake the model directly into the image for production
COPY outputs/models/ ./outputs/models/

# Step 7: Tell Docker this app uses port 8000
EXPOSE 8000

# Step 8: Start the FastAPI server
CMD ["uvicorn", "fastapi_app:app", "--host", "0.0.0.0", "--port", "8000"]